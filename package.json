{
  "name": "djtree",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A node graph for planning DJ sets.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -n vite,electron -c cyan,magenta \"npm:dev:web\" \"npm:dev:app\"",
    "dev:web": "vite",
    "dev:app": "wait-on tcp:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist": "vite build && electron-builder --mac",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.eggshaan.djtree",
    "productName": "djtree",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "music-metadata": "^11.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^9.1.0"
  }
}
